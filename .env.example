# Copy to .env and configure your SMTP provider. Email is logged as unavailable until set.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SALES_EMAIL=sales@example.com
# Optional; defaults to lead_capture.db in the working directory.
DATABASE_PATH=lead_capture.db

# --- Chatbot (all optional; the bot works offline with no keys) ---
# Free key: https://console.groq.com/keys   (no credit card)
GROQ_API_KEY=
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: force one provider (groq | gemini) and/or override model names
CHAT_PROVIDER=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash
